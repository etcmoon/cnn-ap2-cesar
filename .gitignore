# Arquivos que o git deve ignorar

# Ambiente virtual e cache do Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Datasets temporários usados só para testar o pipeline (ex.: dataset sintético)
dataset_teste/
dataset_sintetico/

# Arquivos do sistema e de editores
.DS_Store
Thumbs.db
.vscode/
.idea/
.ipynb_checkpoints/

# Dependências do Node (instaladas com npm install)
node_modules/

# Fotos dos integrantes: são dados pessoais e ficam só na máquina de quem coletou
dataset/*
!dataset/.gitkeep

# Gerados pelo treino e pela busca de hiperparâmetros (o modelo é treinado com os rostos do grupo).
# O detector de rostos YuNet (OpenCV Zoo) fica no repositório.
modelo/*
!modelo/.gitkeep
!modelo/face_detection_yunet_2023mar.onnx
